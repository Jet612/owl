# Owl settings, read by owl-vision and owl-api. Installed to /etc/owl/owl.env
# (readable only by root and the service user). Restart both services after
# editing:  sudo systemctl restart owl-vision owl-api

# Shared with the website's server. It signs media tokens with this and can
# call the API directly as "Authorization: Bearer <secret>".
# The installer generates one.
OWL_API_SECRET=

# Phone notifications: install the ntfy app on each phone and subscribe to
# this topic. Anyone who knows the topic name can read it, so keep it random.
# The installer generates one.
OWL_NTFY_TOPIC=

# Opened when a notification is tapped.
OWL_SITE_URL=

# Browser origins allowed to call the API (comma separated), e.g.
# https://owl.vercel.app. "*" is fine because every request needs a token.
OWL_CORS_ORIGINS=*

# Everything below is optional; the values shown are the defaults.
#
# What triggers a recording (the Hailo chip: people and animal-like objects; plus movement)
#OWL_DETECT_PEOPLE=true
#OWL_ANIMALS=bird,cat,dog,horse,sheep,cow,bear
#OWL_MOTION=true
#OWL_MOTION_MIN_AREA=0.0015    # smallest moving blob, fraction of the frame; lower sees smaller/farther animals
#
# Naming species (the list itself is /etc/owl/species.txt)
#OWL_CLASSIFIER=bioclip         # or "none" to use only the Hailo labels
#OWL_SPECIES_MIN_SCORE=0.95     # confidence needed in each frame; lower means more guesses and more mistakes
#OWL_SPECIES_CONFIRM_FRAMES=2
#OWL_UNIDENTIFIED_DAYS=3        # days to keep clips with an animal nothing could name; 0 deletes them
#
# Clips
#OWL_PRE_ROLL=5
#OWL_POST_ROLL=10
#OWL_MAX_CLIP=120
#OWL_RETENTION_DAYS=30
#OWL_MIN_FREE_GB=5
#
# Notifications
#OWL_NOTIFY_COOLDOWN=300        # at most one per species (or person) in this many seconds
#OWL_NOTIFY_MUTE=               # e.g. eastern gray squirrel,person  (still recorded, no notification)
#OWL_NTFY_SERVER=https://ntfy.sh
#OWL_NTFY_TOKEN=
#
# Video and system
#OWL_VIDEO_WIDTH=1280
#OWL_VIDEO_HEIGHT=720
#OWL_VIDEO_FPS=30
#OWL_VIDEO_BITRATE=2500000
#OWL_HFLIP=false
#OWL_VFLIP=false
#OWL_CLASSIFY_THREADS=3
#OWL_API_PORT=8080
#OWL_LOG_LEVEL=INFO
