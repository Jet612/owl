# Owl settings, read by owl-vision and owl-api. Installed to /etc/owl/owl.env
# (readable only by root and the service user). Restart both services after
# editing:  sudo systemctl restart owl-vision owl-api
#
# One setting per line, NAME=value. Put comments on their own lines: systemd
# does not strip a "# comment" that follows a value, so it would become part of
# the value. Every line below that starts with "#OWL_" is a default you can
# change by removing the "#".

# ---------------------------------------------------------------- required

# Shared with the website's server. It signs media tokens with this and can
# call the API directly as "Authorization: Bearer <secret>".
# The installer generates one.
OWL_API_SECRET=

# Phone notifications: install the ntfy app on each phone and subscribe to
# this topic. Anyone who knows the topic name can read it, so keep it random.
# The installer generates one.
OWL_NTFY_TOPIC=

# The website's address, for example https://owl.vercel.app. Tapping a
# notification opens it. Set this once the site is deployed.
OWL_SITE_URL=

# Browser origins allowed to call the API (comma separated), for example
# https://owl.vercel.app. "*" is fine because every request needs a token.
OWL_CORS_ORIGINS=*

# ---------------------------------------------------------------- what triggers a recording
# The Hailo chip looks for people and animal-like objects. Movement triggers
# too, which is how deer, foxes and rabbits (not Hailo classes) are caught.

# Record people. They are kept behind the site's password and never shared.
#OWL_DETECT_PEOPLE=true

# Animal-like objects the Hailo detector triggers on (COCO class names).
#OWL_ANIMALS=bird,cat,dog,horse,sheep,cow,bear

# Smallest confidence for the Hailo detector to count an animal or a person.
#OWL_ANIMAL_MIN_SCORE=0.35
#OWL_PERSON_MIN_SCORE=0.5

# Hailo detections per second, and how many of the last CONFIRM_WINDOW
# detections must agree before a trigger counts.
#OWL_DETECT_FPS=10
#OWL_CONFIRM_HITS=3
#OWL_CONFIRM_WINDOW=5

# Trigger on movement. MIN_AREA is the smallest moving blob as a fraction of
# the frame: lower it to catch smaller or farther animals, at the cost of more
# false triggers. HITS of the last WINDOW frames must show movement.
#OWL_MOTION=true
#OWL_MOTION_MIN_AREA=0.0015
#OWL_MOTION_HITS=4
#OWL_MOTION_WINDOW=6

# The Hailo model file.
#OWL_MODEL=/usr/share/hailo-models/yolov8s_h8l.hef

# Give up on a trigger after this many "nothing there" frames in a row, and
# ignore movement-only triggers for QUIET_AFTER_FALSE seconds after a false alarm.
#OWL_ABORT_NEGATIVES=4
#OWL_QUIET_AFTER_FALSE=30

# ---------------------------------------------------------------- naming species
# The list of species is /etc/owl/species.txt.

# "bioclip" names the species. "none" trusts the Hailo labels only.
#OWL_CLASSIFIER=bioclip
#OWL_SPECIES_FILE=/etc/owl/species.txt
#OWL_CLASSIFY_THREADS=3

# Confidence needed in each frame, and the number of frames that must agree.
# Lower means more guesses and more mistakes: below 0.9 the classifier is right
# less than 40% of the time.
#OWL_SPECIES_MIN_SCORE=0.95
#OWL_SPECIES_CONFIRM_FRAMES=2

# Once something is named, look again only this often (seconds), to catch a
# second animal.
#OWL_CONFIRMED_INTERVAL=5

# A clip nothing could be named in is kept as "unidentified animal" if the
# classifier thought it saw an animal (at least MIN_SCORE sure) in at least
# MIN_FRAMES frames. It is kept for UNIDENTIFIED_DAYS days; 0 deletes such clips.
#OWL_UNIDENTIFIED_MIN_FRAMES=3
#OWL_UNIDENTIFIED_MIN_SCORE=0.5
#OWL_UNIDENTIFIED_DAYS=3

# ---------------------------------------------------------------- clips
# Clips are the only copy, so a full disk is announced, never silent.

# Seconds of video kept before a trigger and after the last movement, and the
# longest a single clip can run.
#OWL_PRE_ROLL=5
#OWL_POST_ROLL=10
#OWL_MAX_CLIP=120

# Days a named clip is kept, counted from when it starts.
#OWL_RETENTION_DAYS=30

# Below this percentage of free disk space you get a warning notification
# (at most one a day). Below MIN_FREE_GB free, the oldest clips are deleted
# early and you get a notification saying how many.
#OWL_LOW_DISK_PERCENT=10
#OWL_MIN_FREE_GB=5

# ---------------------------------------------------------------- notifications
#OWL_NTFY_SERVER=https://ntfy.sh

# Only for a private or self-hosted ntfy server.
#OWL_NTFY_TOKEN=

# At most one notification per species (or person) in this many seconds.
#OWL_NOTIFY_COOLDOWN=300

# Species to record without notifying, for example: eastern gray squirrel,person
#OWL_NOTIFY_MUTE=

# ---------------------------------------------------------------- video
#OWL_VIDEO_WIDTH=1280
#OWL_VIDEO_HEIGHT=720
#OWL_VIDEO_FPS=30
#OWL_VIDEO_BITRATE=2500000

# Flip the image for odd camera mounts.
#OWL_HFLIP=false
#OWL_VFLIP=false

# ---------------------------------------------------------------- system
# Where owl-vision publishes the camera, for MediaMTX.
#OWL_RTSP_URL=rtsp://127.0.0.1:8554/owl

# MediaMTX's HLS server, which owl-api proxies. Keep it on this machine.
#OWL_HLS_URL=http://127.0.0.1:8888/owl

# The API listens here for Tailscale Funnel. Keep it on 127.0.0.1: Funnel
# connects from this machine, and nothing else should reach it.
#OWL_API_HOST=127.0.0.1
#OWL_API_PORT=8080

# Clips, snapshots, status and the species model. The systemd units only let
# the services write to /var/lib/owl.
#OWL_DATA_DIR=/var/lib/owl

#OWL_LOG_LEVEL=INFO
